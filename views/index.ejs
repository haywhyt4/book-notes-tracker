<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Notes Tracker</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h1>My Book Notes Tracker</h1>
    <p>Keep track of the books you read and the lessons you learn.</p>

    <h2>Search for Books</h2>

    <form action="/search" method="GET">
        <label for="title">Enter a book title:</label>
        <input type="text" id="title" name="title" required>
        <button type="submit">Search</button>
    </form>

    <h2>Add a New Book</h2>

    <form action="/add" method="POST">
        <label for="title">Book Title:</label>
        <input type="text" id="title" name="title" required>

        <br><br>

        <label for="author">Author:</label>
        <input type="text" id="author" name="author">

        <br><br>

        <label for="isbn">ISBN:</label>
        <input type="text" id="isbn" name="isbn">

        <br><br>

        <label for="rating">Rating (1–10):</label>
        <input type="number" id="rating" name="rating" min="1" max="10">

        <br><br>

        <label for="notes">Your Notes:</label>
        <textarea id="notes" name="notes"></textarea>

        <br><br>

        <label for="date_read">Date Read:</label>
        <input type="date" id="date_read" name="date_read">

        <br><br>

        <button type="submit">Add Book</button>
    </form>



    <h2>My Books</h2>

    <form action="/" method="GET">
        <label for="sort">Sort books by:</label>


        <select name="sort" id="sort">
            <option value="newest" <%=(typeof sort==="undefined" || sort==="newest" ) ? "selected" : "" %>>
                Newest Read
            </option>

            <option value="rating" <%=sort==="rating" ? "selected" : "" %>>
                Highest Rated
            </option>

            <option value="title" <%=sort==="title" ? "selected" : "" %>>
                Title (A–Z)
            </option>
        </select>


        <button type="submit">Sort</button>
    </form>


    <% if (books.length===0) { %>
        <p>You haven't added any books yet.</p>
        <% } else { %>
            <% books.forEach((book)=> { %>
                <div class="book-card">
                    <h3>
                        <%= book.title %>
                    </h3>
                    <p>Author: <%= book.author || "Unknown" %>
                    </p>
                    <p>Rating: <%= book.rating ?? "Not rated" %>
                    </p>
                    <p>Notes: <%= book.notes || "No notes yet." %>
                    </p>

                    <p>ISBN: <%= book.isbn || "Not provided" %>
                    </p>

                    <p>
                        Date Read:
                        <%= book.date_read ? new Date(book.date_read).toLocaleDateString("en-GB") : "Not provided" %>
                    </p>

                    <% if (book.isbn) { %>
                        <img src="https://covers.openlibrary.org/b/isbn/<%= book.isbn %>-M.jpg"
                            alt="Cover of <%= book.title %>" width="120">
                        <% } %>

                            <a href="/edit/<%= book.id %>">Edit Book</a>

                            <form action="/delete/<%= book.id %>" method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this book?');">
                                <button type="submit">Delete Book</button>
                            </form>


                </div>
                <hr>
                <% }); %>
                    <% } %>
</body>

</html>