<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Book</title>
</head>

<body>
    <h1>Edit Book</h1>

    <form action="/edit/<%= book.id %>" method="POST">
        <label for="title">Book Title:</label>
        <input type="text" id="title" name="title" value="<%= book.title %>" required>

        <br><br>

        <label for="author">Author:</label>
        <input type="text" id="author" name="author" value="<%= book.author || '' %>">

        <br><br>

        <label for="isbn">ISBN:</label>
        <input type="text" id="isbn" name="isbn" value="<%= book.isbn || '' %>">

        <br><br>

        <label for="rating">Rating (1–10):</label>
        <input type="number" id="rating" name="rating" min="1" max="10" value="<%= book.rating ?? '' %>">

        <br><br>

        <label for="notes">Your Notes:</label>
        <textarea id="notes" name="notes"><%= book.notes || '' %></textarea>

        <br><br>

        <label for="date_read">Date Read:</label>
        <input type="date" id="date_read" name="date_read"
            value="<%= book.date_read ? new Date(book.date_read).toISOString().slice(0, 10) : '' %>">

        <br><br>

        <button type="submit">Save Changes</button>
    </form>

    <p><a href="/">Back to My Books</a></p>
</body>

</html>